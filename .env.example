# Database configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://neondb_owner:password@host-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional: Google Gemini API Key for hybrid conversational intelligence in the Co-pilot.
# If provided, the Co-pilot uses Gemini with live dataset context.
# If omitted, it seamlessly uses the built-in deterministic ML engine.
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Node Environment
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
