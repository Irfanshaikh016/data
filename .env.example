# Database configuration (PostgreSQL)
# Required for persisting datasets, recipes, and co-pilot chat messages across server restarts.
# (If omitted or unavailable, HDCP will fall back to in-memory session storage gracefully for local testing)
DATABASE_URL=postgresql://postgres:password@localhost:5432/cleaning_platform

# Environment & Server Config
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
